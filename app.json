{
  "expo": {
    "name": "NAYVO",
    "slug": "forsa",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forsa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAFF"
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#1267E8",
      "androidMode": "default",
      "androidCollapsedTitle": "NAYVO"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "14",
      "bundleIdentifier": "app.replit.forsa",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "نحتاج الوصول للكاميرا لتصوير إيصال الدفع",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول لمعرض الصور لاختيار إيصال الدفع أو صورة المنتج",
        "UIRequiredDeviceCapabilities": ["arm64"],
        "WKCompanionAppBundleIdentifier": "",
        "UIDeviceFamily": [1]
      }
    },
    "android": {
      "package": "today.forsa",
      "googleServicesFile": "./google-services.json",
      "versionCode": 7,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1267E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://nayvo.store/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1267E8",
          "defaultChannel": "default",
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول لمعرض الصور لاختيار إيصال الدفع أو صورة المنتج",
          "cameraPermission": "نحتاج الوصول للكاميرا لتصوير إيصال الدفع",
          "android": {
            "useAndroidPhotoPicker": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.483140544009-ahvhvdrgc4cgmfbu7es3j1sdis2a0rpo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://nayvo.store/"
      },
      "eas": {
        "projectId": "e753d7dd-1651-4cc5-ae69-b77ba5629277"
      }
    }
  }
}

